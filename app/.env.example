# Copy this file to .env and fill in your own values. .env is gitignored —
# nothing here should ever contain a real, machine-specific path.

# Absolute path to the directory holding the sample databases
# (config.db, master-games.db, my-games.db) this repo's samples/ folder
# builds. Used only by the Tauri desktop build's dev stopgap
# (see src/lib/data/session.js) — the browser/PWA build never reads it.
VITE_SAMPLES_DIR=

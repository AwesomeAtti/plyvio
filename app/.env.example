# Copy this file to .env and fill in your own values. .env is gitignored —
# nothing here should ever contain a real, machine-specific path.

# Absolute path to the directory holding the sample databases
# (config.db, master-games.db, my-games.db) this repo's samples/ folder
# builds. Used only by the Tauri desktop app in development (`npm run tauri
# dev`), as a stopgap (see src/lib/data/session.js). Production builds ignore
# it: Vite would otherwise copy this path into the published JavaScript.
VITE_SAMPLES_DIR=
